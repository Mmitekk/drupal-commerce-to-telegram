<?php

/**
 * @file
 * Webform Telegram Notifier: отправка новых заявок Webform в Telegram.
 */

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_help().
 */
function webform_telegram_notifier_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.webform_telegram_notifier':
      return '<p>' . t('Модуль отправляет новые заявки Webform в Telegram. Токен бота, чат и шаблон сообщения настраиваются на странице <a href=":url">«Telegram-уведомления о заявках»</a>.', [
        ':url' => '/admin/config/system/telegram-notify',
      ]) . '</p>';
  }
  return NULL;
}

/**
 * Implements hook_webform_submission_insert().
 *
 * Срабатывает при создании новой заявки Webform. Ошибка отправки
 * в Telegram никогда не должна прерывать сохранение заявки, поэтому
 * любые исключения пишутся в журнал и подавляются.
 */
function webform_telegram_notifier_webform_submission_insert(WebformSubmissionInterface $webform_submission): void {
  try {
    \Drupal::service('webform_telegram_notifier.sender')->notifySubmission($webform_submission);
  }
  catch (\Throwable $e) {
    \Drupal::logger('webform_telegram_notifier')->error('Не удалось обработать заявку @sid для отправки в Telegram: @message', [
      '@sid' => $webform_submission->id(),
      '@message' => $e->getMessage(),
    ]);
  }
}
